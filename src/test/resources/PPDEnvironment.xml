<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Sanity Test Suite for PPD Environment" data-provider-thread-count="3">
    <parameter name="env" value="PPD" />
    <parameter name="report.execution" value="fresh"/>
    <listeners>
        <listener class-name="utils.ExtentReportListener" />
        <listener class-name="utils.ExtentTestNameListener" />
<!--        <listener class-name="utils.RetryInvokedListener" />-->
    </listeners>
    <!-- OSPC UI Tests will run first as it is the first test block and suite-level parallel is not enabled -->
    <test name="OSPC UI Tests">
        <classes>
<!--            <class name="testRunner.OSPCUI_Tests"/>-->
        </classes>
    </test>

    <!-- The following tests will run in parallel after OSPC UI Tests have completed -->
    <test name="Parallel PPD Tests" parallel="classes" thread-count="5">
        <classes>
            <class name="testRunner.UNCDWSIB_Tests"/>
<!--            <class name="testRunner.UNCDNonWSIB_Tests"/>-->
<!--            <class name="testRunner.UNCDUnnumbered_Tests"/>-->
<!--            <class name="testRunner.NIHL_Tests"/>-->
<!--            <class name="testRunner.WT_Tests"/>-->
<!--            <class name="testRunner.CAA_Tests"/>-->
<!--            <class name="testRunner.OSPCAppeals_Tests"/>-->
<!--            <class name="testRunner.OSPCDocUpload_Tests"/>-->
<!--            <class name="testRunner.DirectDeposit_Test"/>-->
<!--            <class name="testRunner.DIEform6_Tests"/>-->
<!--            <class name="testRunner.OSBC_Tests"/>-->
<!--            <class name="testRunner.B2BForm7"/>-->
<!--            <class name="testRunner.TombstoneEmail_Tests"/>-->
<!--            <class name="testRunner.TombstonePhone_Tests"/>-->
        </classes>
    </test>
</suite>