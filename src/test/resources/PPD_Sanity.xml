<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Sanity Test Suite for PPD Environment">
    <parameter name="env" value="PPD" />
    <listeners>
        <listener class-name="utils.ExtentReportListener" />
        <listener class-name="utils.ExtentTestNameListener" />
<!--         <listener class-name="utils.RetryInvokedListener" />-->
    </listeners>

    <test name="Parallel Phase - All Other Tests" parallel="classes" thread-count="5">
        <classes>
            <class name="testRunner.OSPCDocUpload_Tests"/>
        </classes>
    </test>

</suite>
